      "isDeleted": false,
      "boundElements": null,
      "updated": 1791910800000,
      "link": null,
      "locked": false,
      "index": "a2",
      "text": "Tidligere fullførte trinn er klikkbare. Fremtidige trinn krever nødvendig grunnlag og forklaring av det som gjenstår. Tilbake bevarer fortsatt gyldig grunnlag.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
