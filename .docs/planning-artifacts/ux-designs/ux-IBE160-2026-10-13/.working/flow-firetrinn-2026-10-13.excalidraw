      "isDeleted": false,
      "boundElements": null,
      "updated": 1791910800000,
      "link": null,
      "locked": false,
      "index": "a1",
      "text": "Godkjente trinn og kontrollmekanismer. Gråtoner, geometri, komponentformer og detaljtetthet er illustrative.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "Godkjente trinn og kontrollmekanismer. Gråtoner, geometri, komponentformer og detaljtetthet er illustrative.",
      "lineHeight": 1.25
    },
    {
      "id": "flow-002",
      "type": "text",
      "x": 50,
      "y": 108,
      "width": 1217.0,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#222222",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
