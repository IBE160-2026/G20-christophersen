      "boundElements": null,
      "updated": 1791910800000,
      "link": null,
      "locked": false,
      "index": "f3",
      "text": "Gamle resultater er aldri aktive eller beslutningsklare. Ny gyldig beregning erstatter dem etter nødvendig bekreftelse. Presis geometri og detaljtetthet er ikke valgt.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
