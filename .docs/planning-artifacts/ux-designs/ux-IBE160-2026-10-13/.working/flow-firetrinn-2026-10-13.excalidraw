      "boundElements": null,
      "updated": 1791910800000,
      "link": null,
      "locked": false,
      "index": "f2",
      "text": "Tidligere anbefaling / nøkkeltall beholdes historisk og dempet: «Utdatert / Må bekreftes på nytt». Endring og nødvendig ny bekreftelse forklares.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Tidligere anbefaling / nøkkeltall beholdes historisk og dempet: «Utdatert / Må bekreftes på nytt». Endring og nødvendig ny bekreftelse forklares.",
      "lineHeight": 1.25
    },
    {
