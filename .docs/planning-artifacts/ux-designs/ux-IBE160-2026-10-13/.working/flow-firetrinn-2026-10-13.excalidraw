      "isDeleted": false,
      "boundElements": null,
      "updated": 1791910800000,
      "link": null,
      "locked": false,
      "index": "eJ",
      "text": "Formler, brukte verdier, perioder og kilder / brukerforutsetninger.\nAktive TG2/TG3 med dokumentnavn og PDF-side.\nOpprinnelige KI-funn, brukerrettinger og avvisninger.\nSeparat brukerbekreftet TG3-avklaring.\nMangler, konflikter, usikkerhet og dokument- / analysefeil.\nDelgrunnlag og lagret demoanalyse merkes.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Formler, brukte verdier, perioder og kilder / brukerforutsetninger.\nAktive TG2/TG3 med dokumentnavn og PDF-side.\nOpprinnelige KI-funn, brukerrettinger og avvisninger.\nSeparat brukerbekreftet TG3-avklaring.\nMangler, konflikter, usikkerhet og dokument- / analysefeil.\nDelgrunnlag og lagret demoanalyse merkes.",
      "lineHeight": 1.25
    },
