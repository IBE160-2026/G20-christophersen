      "link": null,
      "locked": false,
      "index": "f1",
      "text": "Stepperen viser også Endret — må oppdateres når berørt grunnlag er endret. Ny rapport krever ny analyse og ny kontroll.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Stepperen viser også Endret — må oppdateres når berørt grunnlag er endret. Ny rapport krever ny analyse og ny kontroll.",
      "lineHeight": 1.25
    },
    {
      "id": "flow-182",
      "type": "text",
