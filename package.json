{
  "name": "property-acquisition-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run typecheck && vite build",
